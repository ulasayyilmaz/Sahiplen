# Copy to .env.local and fill in from Supabase Dashboard → Project Settings → API Keys.
# Both values are public by design (data is protected by RLS).
# Never put the service_role / secret key here or anywhere in this app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional, for `npm run verify:rls` only: the shared password of the four test
# accounts (test-admin / test-staff-a / test-staff-b / test-pending @example.com).
# Never set this in Vercel.
TEST_USER_PASSWORD=
